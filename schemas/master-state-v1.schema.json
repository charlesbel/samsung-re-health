{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charlesbel.github.io/schemas/samsung-account/master-state-v1.schema.json",
  "title": "SamsungAccountMasterStateV1",
  "description": "Neutral shared Samsung Account master state contract v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generation",
    "created_at",
    "updated_at",
    "account",
    "installation",
    "identity"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "io.github.charlesbel.samsung-account.master"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generation": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0
    },
    "account": {
      "type": "object",
      "required": ["login_id"],
      "properties": {
        "login_id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "required": ["physical_address"],
      "properties": {
        "physical_address": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["auth_server_url", "userauth_token"],
      "properties": {
        "auth_server_url": {
          "type": "string",
          "pattern": "^https://[a-zA-Z0-9.-]+\\.(samsungosp\\.com|samsungcloud\\.com|samsung\\.com)(:[0-9]+)?(/.*)?$"
        },
        "userauth_token": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
